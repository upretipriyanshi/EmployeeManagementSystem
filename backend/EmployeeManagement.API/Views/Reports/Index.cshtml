@model EmployeeManagement.API.ViewModels.ReportsViewModel

@{
    ViewData["Title"] = "Reports Dashboard";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f8fafc;
            margin: 0;
            padding: 40px;
            color: #0f172a;
        }

        h1 {
            margin-bottom: 8px;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 30px;
        }

        .report-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .report-card {
            background: white;
            padding: 24px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
        }

        .report-card h3 {
            font-size: 14px;
            color: #64748b;
            margin: 0 0 12px;
        }

        .report-card p {
            font-size: 32px;
            font-weight: 700;
            margin: 0;
        }

        @@media (max-width: 768px) {
            .report-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <h1>Reports Dashboard</h1>
    <p class="subtitle">Overview of employees, projects and tasks</p>

    <div class="report-grid">
        <div class="report-card">
            <h3>Total Employees</h3>
            <p>@Model.TotalEmployees</p>
        </div>

        <div class="report-card">
            <h3>Active Employees</h3>
            <p>@Model.ActiveEmployees</p>
        </div>

        <div class="report-card">
            <h3>Total Projects</h3>
            <p>@Model.TotalProjects</p>
        </div>

        <div class="report-card">
            <h3>Total Tasks</h3>
            <p>@Model.TotalTasks</p>
        </div>

        <div class="report-card">
            <h3>Completed Tasks</h3>
            <p>@Model.CompletedTasks</p>
        </div>

        <div class="report-card">
            <h3>Pending Tasks</h3>
            <p>@Model.PendingTasks</p>
        </div>
    </div>
</body>
</html>